{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HardRecover",
  "version": "1.0.0",
  "identifier": "com.hardsuite.hardrecover",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HardRecover — Récupération Forensique & Chirurgie Média",
        "theme": "Dark",
        "width": 1340,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": { "x": 170, "y": 180 },
        "applicationFolderPosition": { "x": 490, "y": 180 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}

